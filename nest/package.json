{
  "name": "nest", "private": true, "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0", "@nestjs/core": "^11.1.0", "@nestjs/platform-express": "^11.1.0",
    "@nestjs/jwt": "^11.0.0", "class-transformer": "^0.5.1", "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0", "@types/express": "^5.0.0", "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0", "@types/supertest": "^6.0.3", "jest": "^29.7.0",
    "supertest": "^7.1.0", "ts-jest": "^29.2.6", "ts-node": "^10.9.2", "typescript": "^5.8.3"
  },
  "jest": {"preset": "ts-jest", "testEnvironment": "node", "testMatch": ["**/test/**/*.spec.ts"]}
}
