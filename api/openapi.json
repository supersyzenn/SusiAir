{
  "openapi": "3.0.3",
  "info": {
    "title": "Susi Air Pilot API",
    "version": "1.0.0",
    "description": "Read-only pilot operations demo. Login: johndoe / susiairtest. JWT lifetime: 3600 seconds. All date-only business logic defaults to 2026-05-15. Unknown query/body fields are rejected."
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "auth_login",
        "summary": "Sign in with the brief's demo pilot account",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, unknown parameter, or invalid query range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              },
              "example": {
                "username": "johndoe",
                "password": "susiairtest"
              }
            }
          }
        }
      }
    },
    "/pilot/me": {
      "get": {
        "operationId": "pilot_me",
        "summary": "Return the seeded pilot profile and business date",
        "tags": [
          "pilot"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pilot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, unknown parameter, or invalid query range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/flight-hours": {
      "get": {
        "operationId": "hours_daily",
        "summary": "Inclusive daily hours; fill missing days with zero",
        "tags": [
          "hours"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyHours"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, unknown parameter, or invalid query range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": ""
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "Must be >= from; inclusive range up to 3660 days"
          }
        ],
        "description": "Inclusive range, missing days zero. Metadata provides business date and earliest/latest source dates (null for empty source). Statistics are server-computed across the requested range: total hours, number of positive-hour days, and average per flying day (zero when no flying days). Source data may include future projections; Logbook consumers should cap to today for recorded history. Existing from/to/days fields are preserved."
      }
    },
    "/flight-hours/summary": {
      "get": {
        "operationId": "hours_summary",
        "summary": "Server-computed rolling totals and 15-day chart",
        "tags": [
          "hours"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, unknown parameter, or invalid query range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1w",
                "1m",
                "3m",
                "6m",
                "1y"
              ],
              "default": "1w"
            },
            "description": ""
          }
        ],
        "description": "Defaults to business date 2026-05-15; inclusive rolling windows end on each series date. Missing days and dates before seed start contribute zero. Future dates include seeded future records and are labeled projected. Cards always end on today. Chart max is a display bound; series values may exceed it."
      }
    },
    "/documents": {
      "get": {
        "operationId": "documents_list",
        "summary": "Documents with server-derived expiry urgency",
        "tags": [
          "documents"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Documents"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, unknown parameter, or invalid query range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "daysRemaining <= 0: expired; 1 through warningDays (30): soon; otherwise safe. Uses APP_TODAY, overriding the conflicting documents seed date."
      }
    },
    "/schedules": {
      "get": {
        "operationId": "schedules_month",
        "summary": "One month's duties and authoritative legend",
        "tags": [
          "schedules"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Schedules"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, unknown parameter, or invalid query range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "year",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(19|20|21)[0-9]{2}$"
            },
            "description": ""
          },
          {
            "in": "query",
            "name": "month",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(0?[1-9]|1[0-2])$"
            },
            "description": ""
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_check",
        "summary": "Authenticated process health check",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, unknown parameter, or invalid query range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "path"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "Token": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "Pilot": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "totalFlightHours": {
            "type": "number"
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri"
          },
          "today": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "name",
          "totalFlightHours",
          "avatarUrl",
          "today"
        ]
      },
      "FlightDay": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "hours": {
            "type": "number"
          }
        },
        "required": [
          "date",
          "hours"
        ]
      },
      "DailyHours": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "today": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "dataStart": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "nullable": true
          },
          "dataEnd": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "nullable": true
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlightDay"
            }
          },
          "statistics": {
            "type": "object",
            "properties": {
              "totalHours": {
                "type": "number"
              },
              "flyingDays": {
                "type": "integer"
              },
              "averageFlyingDayHours": {
                "type": "number"
              }
            },
            "required": [
              "totalHours",
              "flyingDays",
              "averageFlyingDayHours"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "today",
          "dataStart",
          "dataEnd",
          "days",
          "statistics"
        ]
      },
      "LimitCard": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "monthly",
              "annual"
            ]
          },
          "label": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "windowDays": {
            "type": "integer"
          }
        },
        "required": [
          "key",
          "label",
          "hours",
          "limit",
          "windowDays"
        ]
      },
      "Summary": {
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "range": {
            "type": "string",
            "enum": [
              "1w",
              "1m",
              "3m",
              "6m",
              "1y"
            ]
          },
          "windowDays": {
            "type": "integer"
          },
          "limit": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LimitCard"
            }
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "hours": {
                  "type": "number"
                },
                "projected": {
                  "type": "boolean"
                }
              },
              "required": [
                "date",
                "hours",
                "projected"
              ]
            }
          }
        },
        "required": [
          "today",
          "range",
          "windowDays",
          "limit",
          "max",
          "cards",
          "series"
        ]
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "daysRemaining": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "safe",
              "soon",
              "expired"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "expiryDate",
          "daysRemaining",
          "status"
        ]
      },
      "Documents": {
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "warningDays": {
            "type": "integer"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          }
        },
        "required": [
          "today",
          "warningDays",
          "documents"
        ]
      },
      "Legend": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "required": [
          "code",
          "label",
          "color"
        ]
      },
      "Schedule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "duty_date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "type": "integer"
          },
          "base_name": {
            "type": "string"
          },
          "base_color": {
            "type": "string"
          },
          "duty_type": {
            "type": "string"
          },
          "count_schedules": {
            "type": "integer"
          },
          "count_logbooks": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "duty_date",
          "status",
          "base_name",
          "base_color",
          "duty_type",
          "count_schedules",
          "count_logbooks"
        ]
      },
      "Schedules": {
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "year": {
            "type": "integer"
          },
          "month": {
            "type": "integer"
          },
          "legend": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Legend"
            }
          },
          "schedules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Schedule"
            }
          }
        },
        "required": [
          "today",
          "year",
          "month",
          "legend",
          "schedules"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
